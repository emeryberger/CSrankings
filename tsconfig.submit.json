{
    "compilerOptions": {
	"target": "es6",
	"lib": ["es2017", "dom"],
	"skipLibCheck": true,
	"noImplicitAny": true,
	"noImplicitReturns": true,
	"forceConsistentCasingInFileNames": true,
	"noImplicitThis": true,
	"noUnusedParameters": true,
	"noFallthroughCasesInSwitch": true,
	"strictNullChecks": true,
	"rootDir": "./src",
	"outDir": "submit"
    },
    "files": [
	"src/submit.ts"
    ]
}
